generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSPECTOR
  MAINTENANCE
}

enum InspectionStatus {
  PASS
  FAIL
}

enum ItemStatus {
  PASS
  FAIL
  NA
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String         @unique
  passwordHash         String
  role                 Role
  active               Boolean        @default(true)
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sessions             Session[]
  createdLocations     Location[]     @relation("LocationCreator")
  updatedLocations     Location[]     @relation("LocationUpdater")
  createdExtinguishers Extinguisher[] @relation("ExtinguisherCreator")
  updatedExtinguishers Extinguisher[] @relation("ExtinguisherUpdater")
  inspections          Inspection[]   @relation("InspectionInspector")
  assignedDefects      Defect[]       @relation("DefectAssignee")
  openedDefects        Defect[]       @relation("DefectCreator")
  closedDefects        Defect[]       @relation("DefectCloser")
  updatedDefects       Defect[]       @relation("DefectUpdater")
  defectNotes          DefectNote[]

  @@index([role, active])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Location {
  id            String         @id @default(cuid())
  name          String
  building      String
  floor         String?
  department    String?
  details       String?
  active        Boolean        @default(true)
  createdById   String?
  updatedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     User?          @relation("LocationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("LocationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  extinguishers Extinguisher[]

  @@index([building, floor])
  @@index([active])
}

model Extinguisher {
  id                String       @id @default(cuid())
  code              String       @unique
  agentType         String
  capacity          String
  brand             String?
  serialNumber      String?
  installedAt       DateTime?
  nextMaintenanceAt DateTime?
  locationId        String
  active            Boolean      @default(true)
  notes             String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  location          Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy         User?        @relation("ExtinguisherCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?        @relation("ExtinguisherUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  inspections       Inspection[]
  defects           Defect[]

  @@index([locationId, active])
  @@index([agentType])
  @@index([nextMaintenanceAt])
}

model Inspection {
  id             String           @id @default(cuid())
  extinguisherId String
  inspectorId    String
  inspectedAt    DateTime         @default(now())
  status         InspectionStatus
  notes          String?
  createdAt      DateTime         @default(now())
  extinguisher   Extinguisher     @relation(fields: [extinguisherId], references: [id], onDelete: Restrict)
  inspector      User             @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  items          InspectionItem[]
  defects        Defect[]

  @@index([inspectedAt])
  @@index([status, inspectedAt])
  @@index([extinguisherId, inspectedAt])
  @@index([inspectorId, inspectedAt])
}

model InspectionItem {
  id           String     @id @default(cuid())
  inspectionId String
  criterion    String
  status       ItemStatus
  note         String?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  defects      Defect[]

  @@index([inspectionId])
}

model Defect {
  id               String          @id @default(cuid())
  inspectionId     String
  inspectionItemId String?
  extinguisherId   String
  description      String
  severity         Severity        @default(MEDIUM)
  status           DefectStatus    @default(OPEN)
  assigneeId       String?
  dueAt            DateTime?
  createdById      String
  closedById       String?
  updatedById      String?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  inspection       Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  inspectionItem   InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  extinguisher     Extinguisher    @relation(fields: [extinguisherId], references: [id], onDelete: Restrict)
  assignee         User?           @relation("DefectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy        User            @relation("DefectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy         User?           @relation("DefectCloser", fields: [closedById], references: [id], onDelete: SetNull)
  updatedBy        User?           @relation("DefectUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  notes            DefectNote[]
  image              DefectImage?

  @@index([status, dueAt])
  @@index([extinguisherId, createdAt])
  @@index([assigneeId, status])
  @@index([inspectionId])
}

model DefectImage {
  id        String   @id @default(cuid())
  defectId  String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  defect    Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)
}

model DefectNote {
  id        String   @id @default(cuid())
  defectId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  defect    Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([defectId, createdAt])
}
